// Copy to Secrets.xcconfig (git-ignored) and fill in.
// `musebridge secret` on the Mac prints the URL and secret.
// xcconfig treats // as a comment, so the URL's slashes are escaped with $().

DEVELOPMENT_TEAM = YOUR_TEAM_ID
MUSE_BUNDLE_ID = com.example.musewatch
MUSE_BRIDGE_URL = http:/$()/your-mac.local:8787
MUSE_BRIDGE_SECRET = paste-secret-here
